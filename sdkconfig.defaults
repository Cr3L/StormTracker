# The Knomi V1 module carries 16 MB of flash. Without this the build defaults to
# 2 MB and the bootloader warns that the detected size exceeds the image header.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Two 4 MB OTA slots instead of the default single 1 MB app. See partitions.csv
# for the layout and why OTA specifically is worth the space on this board.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A freshly installed image boots once on probation: unless it calls
# esp_ota_mark_app_valid_cancel_rollback(), the next reset reverts to the slot
# it replaced. This goes in before the first OTA rather than after, because the
# window it protects — an image that is written, boots, and cannot be updated
# again — is exactly the one that costs a USB gesture to escape on this board.
#
# Not BOOTLOADER_APP_ANTI_ROLLBACK, which is a different feature: a secure
# version counter that permanently refuses older images. That is for signed
# firmware with a security fix to enforce, and here it would only make a
# deliberate downgrade impossible.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# esp_https_ota refuses a plain-http URL unless this is set, and says so in the
# log rather than failing obscurely. Updates come from a build server on the
# LAN, over a network the board already had to be trusted on to be reachable at
# all. TLS is a deliberate open item, not an oversight — the certificate bundle
# is ~50 kB and would land in the same change as the feature being tested.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Stack smashing protection. A guard value is written below the return address
# on entry to a protected function and checked on exit; a buffer that ran past
# its end halts the board instead of returning into whatever overwrote it.
#
# Off until the OTA session, on the stated grounds that the code had no parser
# and so could not produce the bug class. esp_http_client now parses headers and
# a body from the network, so that reason expired and this is the payment.
#
# NORM (-fstack-protector), not STRONG. NORM covers functions with buffers over
# 8 bytes, which is every buffer in this tree that anything is copied into.
# STRONG adds small arrays and frame-address references, for more stack per
# protected frame — and the lwIP tcpip task, which runs the SNTP callback, was
# measured with only ~1.4 kB spare of its 3072. Coverage that costs headroom on
# the tightest stack in the image is not obviously a gain.
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# -Os, not IDF's default -Og. The LVGL software renderer's per-pixel work is
# what sets frame time here, and the whole image is smaller for it. Debug builds
# can still be had with menuconfig when a specific bug wants them.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 1 kHz tick keeps vTaskDelay granularity at 1 ms. Nothing needs that yet — the
# LVGL tick is 10 ms and the shortest delay in the tree is 30 ms — so this is
# headroom, not a requirement, and it costs ~900 extra timer interrupts/s.
# Revisit at 100 Hz if the tick ISR ever shows up competing with Wi-Fi.
CONFIG_FREERTOS_HZ=1000

# The bootloader gets 0x7000 — it starts at 0x1000 and the partition table is
# pinned at 0x8000 — and at INFO it was using all but 2.4 kB of that. Nothing
# needs it: the bootloader's INFO lines describe a load sequence that is
# identical every boot, and a failure still reports at WARN. Buys back a few kB
# of format strings against the day secure boot or flash encryption lands, both
# of which grow the bootloader and neither of which fails legibly when it
# overflows. Moving the partition table instead would work and was rejected:
# that offset is baked into every board already flashed, and shifting it means
# erasing nvs — the thing partitions.csv exists to avoid.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# LVGL ships only Montserrat 14 by default; the UI uses 28 for the centre value.
CONFIG_LV_FONT_MONTSERRAT_28=y
# Full warning words must fit the round screen without splitting mid-word.
CONFIG_LV_FONT_MONTSERRAT_20=y

# LVGL's builtin allocator reserves this much DRAM in .bss unconditionally, at
# link time, whether or not anything uses it. The default 64 kB was the single
# largest DRAM consumer in the image and would collide with Wi-Fi later; the
# current UI needs well under 16 kB.
CONFIG_LV_MEM_SIZE_KILOBYTES=16
